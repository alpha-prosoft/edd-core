{:deps {app-group-id/edd-core {:local/root "../../"}
        org.apache.kafka/kafka-clients {:mvn/version "4.4.0"}}
 :paths ["src"]
 :aliases {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}}
                   :ns-default build}
           :test {:extra-paths ["test"]}
           :unit {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                  :main-opts ["-m" "kaocha.runner" "unit"]
                  :jvm-opts ["-Dclojure.tools.logging.factory=lambda.logging-local/slf4j-local-factory"]}
           :it {:extra-deps {lambdaisland/kaocha {:mvn/version "1.91.1392"}}
                :main-opts ["-m" "kaocha.runner" "it"]
                :jvm-opts ["-Dclojure.tools.logging.factory=lambda.logging-local/slf4j-local-factory"]}}}
